<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="나의 활동 내역"
        app:titleTextColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나의 활동 내역"
                android:textSize="22sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="최근 30일간의 활동을 요약해서 보여줍니다."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

            <!-- Summary Grid (4행 2열, 크레딧 버튼과 동일한 로직) -->
            <GridLayout
                android:id="@+id/layoutSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:useDefaultMargins="true"
                android:alignmentMode="alignBounds"
                android:rowOrderPreserved="true"
                android:columnOrderPreserved="true">

                <!-- Card 1: 전체 활동 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardTotal"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 2: 로그인 기록 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardLogin"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 3: 프로필 분석 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardAnalysis"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 4: 매칭 활동 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardMatch"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 5: 활동 일수 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardDays"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 6: 일평균 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardAverage"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 7: 최근 활동 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardRecent"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />
                <!-- Card 8: 최다 활동일 -->
                <include layout="@layout/item_activity_summary_card" android:id="@+id/cardPeak"
                    android:layout_width="0dp" android:layout_height="110dp" android:layout_columnWeight="1" android:layout_gravity="fill" />

            </GridLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="활동 기록"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/text_primary"
                android:layout_marginTop="32dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActivities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tvEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="최근 활동이 없습니다."
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
